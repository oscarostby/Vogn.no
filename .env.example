# ─────────────────────────────────────────────────────────────────────────────
# VOGN environment configuration
# Copy to apps/web/.env.local for local development. Never commit real values.
# Required: MongoDB, Clerk, DATA_ENCRYPTION_KEY, APP_SIGNING_SECRET.
# Everything else is optional — features without configuration fail safely with
# a CONFIG_MISSING error and are listed at /api/v1/health.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas (server-only). Use a dedicated database user with readWrite on MONGODB_DB.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.f5ebhxb.mongodb.net/?appName=Cluster0
MONGODB_DB=vogn
# Set to false only for a standalone local mongod without a replica set.
MONGODB_TRANSACTIONS=true

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks (events: user.updated, user.deleted) → signing secret
CLERK_WEBHOOK_SIGNING_SECRET=
# Extra origins allowed to use Clerk sessions (comma-separated), e.g. https://www.vogn.no
CLERK_AUTHORIZED_PARTIES=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Security (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DATA_ENCRYPTION_KEY=
# ≥ 32 random characters (node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
APP_SIGNING_SECRET=
# Bearer secret used by Vercel Cron for /api/cron/*
CRON_SECRET=
# Clerk user ids promoted to platform admin on onboarding (comma-separated)
PLATFORM_ADMIN_CLERK_IDS=

# Ably realtime (server-only root key; clients only ever receive scoped token requests)
ABLY_API_KEY=

# Cloudinary (public media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=vogn
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudflare R2 (private verification evidence — bucket must NOT be public)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
VERIFICATION_EVIDENCE_RETENTION_DAYS=30

# Statens vegvesen technical vehicle data (Norway) — requires an API key ordered with Norwegian eID
VEGVESEN_API_KEY=
VEGVESEN_API_URL=https://akfell-datautlevering.atlas.vegvesen.no

# LiveKit Cloud (voice channels)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Upstash Redis (optional; MongoDB-backed rate limiting is used otherwise)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Expo push (optional access token if "enhanced push security" is enabled)
EXPO_ACCESS_TOKEN=

# Feature flags
FEATURE_VOICE=true
FEATURE_MARKETPLACE=true
FEATURE_PUSH=true
